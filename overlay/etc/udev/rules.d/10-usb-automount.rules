KERNEL=="sd[a-z][0-9]", SUBSYSTEM=="block", ACTION=="add", RUN+="/bin/systemctl start usb-automount@%k.service"
KERNEL=="sd[a-z][0-9]", SUBSYSTEM=="block", ACTION=="remove", RUN+="/bin/systemctl stop usb-automount@%k.service"

KERNEL=="mmcblk[1-9]p[0-9]", SUBSYSTEM=="block", ACTION=="add", RUN+="/bin/systemctl start usb-automount@%k.service"
KERNEL=="mmcblk[1-9]p[0-9]", SUBSYSTEM=="block", ACTION=="remove", RUN+="/bin/systemctl stop usb-automount@%k.service"
