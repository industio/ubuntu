[Unit]
Description=USB Device Startup Service
After=udev.service systemd-user-sessions.service multi-user.target
Wants=udev.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStartPre=modprobe libcomposite
ExecStartPre=modprobe usb_f_fs
ExecStart=/usr/bin/usbdevice start

User=root

[Install]
WantedBy=multi-user.target
